17:T99b,[{"@context":"https://schema.org","@type":"Service","name":"Mercury spill cleanup in Canada","serviceType":"mercury spill cleanup","provider":{"@type":"Organization","name":"Canada Spill Cleanup & Remediation","telephone":"+1888XXXXXXX","url":"https://spillresponsecrew.com/"},"areaServed":"Canada (National)","url":"https://spillresponsecrew.com/mercury-spill-cleanup","description":"Mercury demands specialized kits—do not vacuum or wash into drains. National mercury spill cleanup routing covers every province—share your postal code so we assign the nearest metro crew. Canadian winters, vandalism, and vehicle strikes all show up on our dispatch board—tell us which scenario you are in. Call 1-888-XXX-XXXX with the address, photos of the break, and whether the spill zone is exposed to weather. We document measurements, on-site method, and install date in plain language. If you are unsure whether you need repair or full replacement, describe the crack pattern when you call."},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://spillresponsecrew.com/"},{"@type":"ListItem","position":2,"name":"Services","item":"https://spillresponsecrew.com/services"},{"@type":"ListItem","position":3,"name":"Mercury spill cleanup Canada","item":"https://spillresponsecrew.com/mercury-spill-cleanup"}]},{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What affects the price of mercury spill cleanup in Canada?","acceptedAnswer":{"@type":"Answer","text":"We do not publish one national price because drain hardware and rated thickness vary. 1-888-XXX-XXXX outlines typical costs for Canada."}},{"@type":"Question","name":"Can you prioritize mercury spill cleanup if the spill zone is exposed in Canada?","acceptedAnswer":{"@type":"Answer","text":"Board-up can often happen the same night; custom spill depends on supplier lead times. Share urgency when you dial 1-888-XXX-XXXX."}},{"@type":"Question","name":"Do I need to be on site for mercury spill cleanup in Canada?","acceptedAnswer":{"@type":"Answer","text":"Clear a path to the spill zone and note ceiling height limits for long spillls."}},{"@type":"Question","name":"Does this page change the phone number for mercury spill cleanup?","acceptedAnswer":{"@type":"Answer","text":"Yes—1-888-XXX-XXXX is the same nationwide. This page adds local context for Canada."}}]}]c:["$","main",null,{"children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$17"}}],["$","nav",null,{"className":"breadcrumb wrap","aria-label":"Breadcrumb","children":[["$","$L19",null,{"href":"/","children":"Home"}],["$","span",null,{"aria-hidden":"true","children":" / "}],["$","$L19",null,{"href":"/services","children":"Services"}],["$","span",null,{"aria-hidden":"true","children":" / "}],["$","span",null,{"aria-current":"page","children":"Mercury spill cleanup Canada"}]]}],["$","section",null,{"className":"runway-hero runway-hero--page","aria-labelledby":"runway-hero-title","children":[["$","div",null,{"className":"runway-hero__bg","aria-hidden":"true","children":[["$","$L1a",null,{"src":"/images/spill-mercury-spill.webp?v=4","alt":"","fill":true,"priority":true,"sizes":"100vw","className":"runway-hero__bg-img"}],["$","div",null,{"className":"runway-hero__bg-shade"}]]}],["$","div",null,{"className":"wrap runway-hero__layout","children":[["$","div",null,{"className":"runway-hero__copy","children":[["$","p",null,{"className":"runway-kicker","children":"Canada"}],["$","h1",null,{"id":"runway-hero-title","children":"Mercury spill cleanup in Canada"}],"$L1b","$L1c","$L1d"]}],"$L1e"]}]]}],"$L1f"]}]
